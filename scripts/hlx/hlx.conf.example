# Copy to ~/.config/hlx/hlx.conf (sourced by hlx.sh as bash, outside the sandbox).
# Everything is optional except HELIX_APPIMAGE; see the header of hlx.sh.

HELIX_APPIMAGE="$HOME/path/to/helix-25.07.1-x86_64.AppImage"

